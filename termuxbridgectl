#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

ROOT="${TERMUXBRIDGE_ROOT:-$HOME/termux-mcp-bridge}"
JOB_ID=38038
SCHEDULER_STATE="$ROOT/state/auto_update.json"

SCHEDULED_RUN_STATE="$ROOT/state/scheduled_maintenance.json"

record_scheduler_state() {
  mkdir -p "$ROOT/state"
  chmod 700 "$ROOT/state"
  python - "$SCHEDULER_STATE" "$JOB_ID" "$1" <<'PY_STATE'
import json, os, sys, tempfile, time, uuid
path, job_id, enabled = sys.argv[1:]
payload = {
    "enabled": enabled == "true",
    "job_id": int(job_id),
    "period_ms": 3600000,
    "request_id": uuid.uuid4().hex,
    "requested_at": time.time(),
    "registration": "SUBMITTED_UNVERIFIED" if enabled == "true" else "CANCEL_REQUESTED",
}
fd, tmp = tempfile.mkstemp(prefix=".auto-update.", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fp:
        json.dump(payload, fp, sort_keys=True)
        fp.write("\n")
        fp.flush()
        os.fsync(fp.fileno())
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
PY_STATE
}

scheduler_status() {
  # Do NOT call termux-job-scheduler --pending. Termux:API 0.53.0
  # may crash with NetworkRequest.toString() on a null NetworkRequest.
  # A successful submission is not proof Android retained the job.
  python - "$SCHEDULER_STATE" "$SCHEDULED_RUN_STATE" "$JOB_ID" <<'PY_STATUS'
import json, sys
request_path, run_path, job_id = sys.argv[1:]
try:
    with open(request_path, encoding="utf-8") as fp:
        request = json.load(fp)
except (OSError, ValueError, TypeError):
    request = {}
if request.get("job_id") != int(job_id) or request.get("enabled") is not True:
    print("AUTO_UPDATE_STATUS DISABLED_OR_UNVERIFIED")
    raise SystemExit(1)
try:
    with open(run_path, encoding="utf-8") as fp:
        run = json.load(fp)
except (OSError, ValueError, TypeError):
    run = {}
if (
    request.get("request_id") and
    run.get("request_id") == request["request_id"] and
    run.get("job_id") == int(job_id) and
    isinstance(run.get("finished_at"), (int, float)) and
    run["finished_at"] >= request.get("requested_at", float("inf"))
):
    if run.get("exit_code") == 0:
        print("AUTO_UPDATE_STATUS SCHEDULED_EXECUTION_VERIFIED")
        print("AUTO_UPDATE_REGISTRATION CURRENTLY_PENDING_UNVERIFIED")
        raise SystemExit(0)
    print("AUTO_UPDATE_STATUS SCHEDULED_EXECUTION_FAILED")
    raise SystemExit(1)
print("AUTO_UPDATE_STATUS SUBMITTED_UNVERIFIED")
raise SystemExit(1)
PY_STATUS
}

case "${1:-check}" in
  check)
    "$ROOT/status_bridge.sh"
    ;;
  status|update-status)
    printf 'TermuxBridge\n'
    printf '  source_commit: %s\n' "$(cat "$ROOT/source_commit" 2>/dev/null || echo unknown)"
    "$ROOT/status_bridge.sh"
    ;;
  update|update-now)
    shift || true
    # Copy the updater before running it, so a version swap cannot truncate
    # the executing script even if an older updater uses non-atomic cp.
    mkdir -p "$ROOT/state"
    snapshot="$(mktemp "$ROOT/state/.manual-updater.XXXXXX")"
    cp "$ROOT/update_termux.sh" "$snapshot"
    chmod 700 "$snapshot"
    set +e
    "$snapshot" --force "$@"
    rc=$?
    set -e
    rm -f "$snapshot"
    exit "$rc"
    ;;
  restart)
    "$ROOT/stop_bridge.sh"
    exec "$ROOT/start_bridge.sh"
    ;;
  logs)
    tail -n "${2:-100}" "$ROOT/logs/update.log" 2>/dev/null || true
    ;;
  dashboard)
    exec python "$ROOT/current/ecosystem_cli.py" dashboard "$ROOT"
    ;;
  dashboard-html)
    exec python "$ROOT/current/ecosystem_cli.py" html "$ROOT"
    ;;
  backup-create)
    exec python "$ROOT/current/ecosystem_cli.py" backup-create "$ROOT"
    ;;
  backup-list)
    exec python "$ROOT/current/ecosystem_cli.py" backup-list "$ROOT"
    ;;
  backup-verify)
    [[ -n "${2:-}" ]] || { echo "Backup filename required" >&2; exit 2; }
    exec python "$ROOT/current/ecosystem_cli.py" backup-verify "$ROOT" "$2"
    ;;
  backup-restore)
    [[ -n "${2:-}" ]] || { echo "Backup filename required" >&2; exit 2; }
    if [[ "${3:-}" == "--yes" ]]; then
      exec python "$ROOT/current/ecosystem_cli.py" backup-restore "$ROOT" "$2" --yes
    fi
    exec python "$ROOT/current/ecosystem_cli.py" backup-restore "$ROOT" "$2"
    ;;
  chaos-test)
    exec python "$ROOT/current/ecosystem_cli.py" chaos-test "$ROOT"
    ;;
  auto-update-enable)
    [[ -x "$ROOT/scheduled_maintain_bridge.sh" ]] || {
      echo "Scheduled maintenance wrapper missing; update TermuxBridge first" >&2
      exit 1
    }
    # Receipt first: an immediate dispatch can record the same request_id.
    record_scheduler_state true
    if termux-job-scheduler --script "$ROOT/scheduled_maintain_bridge.sh" --job-id "$JOB_ID" --period-ms 3600000 --network any --battery-not-low false --storage-not-low true --persisted true >/dev/null; then
      echo "TermuxBridge hourly JobScheduler request submitted; execution not yet verified."
      scheduler_status || true
    else
      echo "JobScheduler registration failed; current registration is unverified." >&2
      exit 1
    fi
    ;;
  auto-update-disable)
    if termux-job-scheduler --cancel --job-id "$JOB_ID" >/dev/null; then
      record_scheduler_state false
      echo "TermuxBridge JobScheduler cancellation requested."
    else
      echo "JobScheduler cancellation failed; cannot confirm disabled state." >&2
      exit 1
    fi
    ;;
  auto-update-status)
    scheduler_status
    ;;
  maintenance-now|auto-update-now)
    exec "$ROOT/maintain_bridge.sh"
    ;;
  maintenance-status)
    if [[ -f "$ROOT/state/maintenance.json" ]]; then
      python - "$ROOT/state/maintenance.json" <<'PY'
import json,sys
s=json.load(open(sys.argv[1]))
for key in ("last_checked_at","last_success_at","result","reason","consecutive_failures","installed_generation","active_generation","update_phase","tunnel_state","startup_exit_code","updater_exit_code","free_storage_mb","fault_code","severity","recommended_action"):
    print(key.upper(),s.get(key,"UNKNOWN"))
PY
    else
      echo "No scheduled maintenance run recorded yet."
    fi
    echo "== Android schedule =="
    scheduler_status || true
    ;;
  *)
    echo "Usage: termuxbridgectl {check|status|update-status|update|update-now|restart|logs [N]|auto-update-enable|auto-update-disable|auto-update-status|maintenance-now|maintenance-status|dashboard|dashboard-html|backup-create|backup-list|backup-verify|backup-restore|chaos-test}" >&2
    exit 2
    ;;
esac
